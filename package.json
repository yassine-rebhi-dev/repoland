{
  "name": "repoland",
  "version": "0.3.0",
  "description": "Map any codebase as an isometric town (SVG + interactive 3D) that stays in sync with the code: drift checks and PR impact in CI.",
  "type": "module",
  "bin": {
    "repoland": "dist/src/bin.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/viewer",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c vite.viewer.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.viewer.json",
    "lint": "biome lint src test scripts web viewer",
    "test": "vitest run",
    "gallery": "node dist/scripts/gallery.js",
    "web:dev": "vite web",
    "web:build": "vite build web --outDir ../dist-web --emptyOutDir --base ./",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:viewer": "vite build -c vite.viewer.config.ts"
  },
  "keywords": [
    "isometric",
    "architecture",
    "diagram",
    "svg",
    "claude-code",
    "codex",
    "agent-skill",
    "visualization",
    "codebase",
    "3d",
    "threejs",
    "architecture-as-code",
    "ci",
    "pull-request",
    "monorepo",
    "mcp",
    "codeowners",
    "mermaid",
    "heatmap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassine-rebhi-dev/repoland.git"
  },
  "homepage": "https://yassine-rebhi-dev.github.io/repoland/",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
